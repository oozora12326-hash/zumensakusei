        } else if (item.type === 'line') {
          targetCtx.beginPath();
          targetCtx.moveTo(item.x1, item.y1);
          targetCtx.lineTo(item.x2, item.y2);
          targetCtx.stroke();
        } else if (item.type === 'rect') {
          targetCtx.strokeRect(item.x, item.y, item.w, item.h);
        } else if (item.type === 'ellipse') {
          targetCtx.beginPath();
          targetCtx.ellipse(item.cx, item.cy, item.rx, item.ry, 0, 0, Math.PI * 2);
          targetCtx.stroke();
        } else if (item.type === 'dimension') {
          drawDimension(targetCtx, item, isHoveredForErase);
