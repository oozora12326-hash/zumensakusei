      function drawGrid(targetCtx, width, height) {
        const step = 40; // 約5〜7mm相当のグリッド間隔
        targetCtx.save();
        targetCtx.strokeStyle = '#e2e8f0';
        targetCtx.lineWidth = 1;
        targetCtx.beginPath();
        for (let x = step; x < width; x += step) {
          targetCtx.moveTo(x, 0);
          targetCtx.lineTo(x, height);
        }
        for (let y = step; y < height; y += step) {
          targetCtx.moveTo(0, y);
          targetCtx.lineTo(width, y);
        }
        targetCtx.stroke();

        // 5マスごとの濃い線
        targetCtx.strokeStyle = '#cbd5e1';
        targetCtx.beginPath();
        for (let x = step * 5; x < width; x += step * 5) {
          targetCtx.moveTo(x, 0);
          targetCtx.lineTo(x, height);
        }
        for (let y = step * 5; y < height; y += step * 5) {
          targetCtx.moveTo(0, y);
          targetCtx.lineTo(width, y);
        }
        targetCtx.stroke();
        targetCtx.restore();
