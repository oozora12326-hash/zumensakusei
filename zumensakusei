        targetCtx.lineJoin = 'round';
        targetCtx.strokeStyle = isHoveredForErase ? '#f43f5e' : item.color;
        targetCtx.fillStyle = isHoveredForErase ? '#f43f5e' : item.color;
        targetCtx.lineWidth = item.width || 2.5;
        if (isHoveredForErase) {
